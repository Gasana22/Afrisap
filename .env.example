# ==========================================
# Application
# ==========================================
APP_NAME="Smart Farm Management & Traceability Platform"
APP_URL="http://localhost:8080"
APP_ENV="local"
APP_DEBUG=true
APP_TIMEZONE="Africa/Kigali"

# ==========================================
# Database (single shared database)
# ==========================================
DB_HOST="db"
DB_NAME="farm"
DB_USER="sfmtp"
DB_PASSWORD="sfmtp_password"
DB_PORT=3306
DB_CHARSET="utf8mb4"

# ==========================================
# Mail
# ==========================================
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="noreply@example.com"
MAIL_PASSWORD="app-password"
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Smart Farm Platform"
# When true, mail is written to logs/mail.log instead of being sent (useful for local dev)
MAIL_LOG_ONLY=true

# ==========================================
# Authentication
# ==========================================
APP_SECRET="change-this-to-a-random-64-character-string"
SESSION_TIMEOUT_MINUTES=120

# ==========================================
# Storage / Uploads
# ==========================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"

# ==========================================
# External APIs (optional - platform degrades gracefully without these)
# ==========================================
GOOGLE_MAPS_API_KEY=""
OPENWEATHER_API_KEY=""

# ==========================================
# Default Subscription Plan Limits
# ==========================================
PLAN_FREE_MAX_FARMS=1
PLAN_FREE_MAX_USERS=3
PLAN_BASIC_MAX_FARMS=5
PLAN_BASIC_MAX_USERS=10
PLAN_PROFESSIONAL_MAX_FARMS=20
PLAN_PROFESSIONAL_MAX_USERS=50
PLAN_ENTERPRISE_MAX_FARMS=999
PLAN_ENTERPRISE_MAX_USERS=999

# ==========================================
# Security
# ==========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_MINUTES=1

# ==========================================
# Logging
# ==========================================
LOG_ERRORS=true
LOG_LEVEL="error"
