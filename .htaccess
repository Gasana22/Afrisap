RewriteEngine On

# Deny direct access to sensitive folders
RewriteRule ^(config|includes|database|logs|vendor)/ - [F,L]

# Public traceability pages: /org/{slug}/page -> org/_slug/page.php?slug={slug}
RewriteRule ^org/([^/]+)/?$ org/_slug/index.php?slug=$1 [QSA,L]
RewriteRule ^org/([^/]+)/([a-zA-Z0-9_-]+)\.php$ org/_slug/$2.php?slug=$1 [QSA,L]
RewriteRule ^org/([^/]+)/([a-zA-Z0-9_-]+)/?$ org/_slug/$2.php?slug=$1 [QSA,L]

# Root -> public landing page
RewriteRule ^$ public/index.php [L]

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Inline <script>/<style> blocks are used throughout the app, so this
    # isn't a strict CSP - it still restricts every load to self + the
    # specific third-party hosts the app actually uses (fonts, CDN JS/CSS,
    # OpenStreetMap tiles), blocking arbitrary third-party injection.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https://*.tile.openstreetmap.org https://cdn.jsdelivr.net; connect-src 'self'; frame-ancestors 'self'"
</IfModule>

<FilesMatch "\.(env|sql|log|md)$">
    Require all denied
</FilesMatch>

Options -Indexes
