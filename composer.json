{
    "name": "afrisap/sfmtp",
    "description": "Smart Farm Management & Traceability Platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mysqli": "*",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^2.3",
        "phpmailer/phpmailer": "^6.9",
        "endroid/qr-code": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "app/core/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
