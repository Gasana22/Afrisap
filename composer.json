{
    "name": "afrisap/smart-farm-platform",
    "description": "Smart Farm Management & Traceability Platform (SFMTP) - multi-tenant SaaS web application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mysqli": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "endroid/qr-code": "^5.0",
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^2.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "includes/lib/App/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10"
    }
}
